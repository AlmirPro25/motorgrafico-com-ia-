generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  username      String?   @unique // Added from conceptual plan
  displayName   String?   // Added from conceptual plan
  profileImage  String?   // Added from conceptual plan
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
}

model Project {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String?
  thumbnailUrl   String?   // Added from conceptual plan
  category       String?   // Added from conceptual plan (e.g. 'game', 'simulation', 'art')
  tags           String[]  // Added from conceptual plan as array of strings
  settings       Json?
  isPublic       Boolean   @default(false) // Added from conceptual plan
  version        Int       @default(1)     // Added from conceptual plan
  lastPublishedAt DateTime? // Added from conceptual plan
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets         Asset[]
  processingJobs ProcessingJob[]
}

model Asset {
  id              String    @id @default(cuid())
  projectId       String
  type            String    // 'mundo', 'personagem', 'objeto', 'midia_referencia', 'render_output', 'material', 'textura', 'script'
  name            String
  description     String?
  status          String    @default("draft") // 'draft', 'uploading', 'processing', 'ready', 'error', 'archived'
  tags            String[]  // Added from conceptual plan
  metadata        Json?     // For type-specific data not fitting other models
  storagePath     String?   // Added from conceptual plan (path to raw file if applicable)
  version         Int       @default(1) // Added from conceptual plan
  license         String?   // Added from conceptual plan
  isPublic        Boolean   @default(false) // Added from conceptual plan
  sourceAssetId   String?   // For derived assets, added from conceptual plan
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaReferences MediaReference[]
  processingJobs  ProcessingJob[]
  worldScene      WorldScene?
  characterModel  CharacterModel?
  objectModel     ObjectModel?
  renderOutput    RenderOutput?
  // Relations for new types if they become their own models later:
  // material        Material?
  // texture         Texture?
  // script          Script?
  sourceAsset     Asset?    @relation("DerivedAssets", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  derivedAssets   Asset[]   @relation("DerivedAssets")
}

model MediaReference {
  id          String   @id @default(cuid())
  assetId     String
  type        String   // 'image', 'video', 'audio', 'document'
  url         String   // Could be an external URL or a path to a managed file
  filename    String?  // Added from conceptual plan
  mimeType    String?  // Added from conceptual plan
  sizeBytes   Int?     // Added from conceptual plan
  metadata    Json?    // e.g., image dimensions, video duration
  description String?  // Added from conceptual plan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Added from conceptual plan
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model ProcessingJob {
  id            String   @id @default(cuid())
  projectId     String
  assetId       String?
  type          String   // 'generate_3d_image', 'generate_3d_text', 'render_scene', 'process_media', 'analyze_asset', 'train_model'
  status        String   @default("pending") // 'pending', 'queued', 'running', 'completed', 'failed', 'cancelled'
  inputData     Json?
  outputData    Json?    // Could store direct small outputs or references to larger ones (e.g. new Asset IDs)
  priority      Int      @default(0) // Added from conceptual plan
  progress      Float?   @default(0) // Added from conceptual plan (0.0 to 1.0)
  logs          Json?    // Store array of log messages or structured logs
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt // Added from conceptual plan
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset         Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  renderOutputs RenderOutput[]
}

model WorldScene {
  id                  String   @id @default(cuid())
  assetId             String   @unique
  sceneData           Json?    // e.g., Three.js scene JSON, list of objects and their transforms
  environmentSettings Json?    // Lighting, skybox, physics settings
  version             Int      @default(1) // Added from conceptual plan
  lastBakedAt         DateTime? // Added from conceptual plan (e.g. for lightmaps)
  interactivePoints   Json?    // Added from conceptual plan (e.g. for navigation or interaction)
  asset               Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) // Added for consistency
  updatedAt           DateTime @updatedAt    // Added for consistency
}

model CharacterModel {
  id              String   @id @default(cuid())
  assetId         String   @unique
  modelUrl        String?  // Path to GLB, FBX, etc.
  skeletonData    Json?    // Bone structure, rigging info
  animationData   Json?    // List of animations, blend shapes
  customizationOptions Json? // Added from conceptual plan (e.g. color palettes, attachments)
  voiceId         String?  // Added from conceptual plan (link to a voice asset or service)
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) // Added for consistency
  updatedAt       DateTime @updatedAt    // Added for consistency
}

model ObjectModel {
  id                String   @id @default(cuid())
  assetId           String   @unique
  modelUrl          String?  // Path to GLB, FBX, etc.
  physicalProperties Json?   // Added from conceptual plan (mass, friction, etc.)
  interactionLogic  Json?    // Added from conceptual plan (e.g. script references, event triggers)
  metadata          Json?    // General metadata
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) // Added for consistency
  updatedAt         DateTime @updatedAt    // Added for consistency
}

model RenderOutput {
  id           String   @id @default(cuid())
  assetId      String   @unique // Each RenderOutput IS an Asset
  jobId        String?  // The ProcessingJob that created this output
  outputUrl    String   // Path/URL to the rendered file (e.g. PNG, MP4)
  format       String?  // 'PNG', 'JPEG', 'MP4', 'GIF'
  resolution   String?  // '1920x1080', '1280x720'
  sizeBytes    Int?     // Added from conceptual plan
  durationMs   Int?     // Added for videos/animations
  metadata     Json?    // e.g., camera settings used, render time
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  job          ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull) // Job might be deleted, but output remains
  createdAt    DateTime @default(now()) // Added for consistency
  updatedAt    DateTime @updatedAt    // Added for consistency
}

