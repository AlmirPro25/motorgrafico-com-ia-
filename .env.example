# Server Configuration
PORT=3001

# PostgreSQL Database Configuration
PGHOST=localhost
PGUSER=your_db_user
PGDATABASE=socialconnect_db
PGPASSWORD=your_db_password
PGPORT=5432

# JWT Configuration
JWT_SECRET=yourjwtsecretkey
JWT_EXPIRES_IN=1d # e.g., 1d, 7d, 1h, 30m

# Node Environment
NODE_ENV=development # or production, test
